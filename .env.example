# --- Airwallex -----------------------------------------------------------------
# mock (default): synthetic in-memory sandbox, no keys needed.
# sandbox: real Airwallex sandbox (https://www.sandbox.airwallex.com, free, no KYC).
AIRWALLEX_MODE=mock
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# AP invoice book (sandbox mode). scripts/seed_sandbox.py writes this file.
INVOICE_BOOK_PATH=
# Webhook secret from the sandbox web app (Settings > Developer > Webhooks).
AIRWALLEX_WEBHOOK_SECRET=
LOOKBACK_DAYS=30

# --- Safety -----------------------------------------------------------------------
# HMAC secret for approval tokens. Random per process if unset (approvals do
# not survive a restart, which is the safe default).
APPROVAL_SECRET=
APPROVAL_TTL_S=900
# Optional PIN the human approver must type (set this on any public deploy in sandbox mode).
APPROVAL_PIN=
# Persist duplicate-payout locks across restarts (recommended in sandbox mode).
LEDGER_PATH=data/ledger.json

# --- LLM: any OpenAI-compatible /chat/completions with tool calling ------------------
# Default: Groq free tier. Leave LLM_API_KEY empty (or LLM_MOCK=1) for the
# deterministic no-LLM analyst.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MOCK=

# --- App ------------------------------------------------------------------------------
RATE_LIMIT_PER_10MIN=60
